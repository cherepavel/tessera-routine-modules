<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.byzatic</groupId>
        <artifactId>Industrial-Pipeline-TesseraModules</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>workflowroutine-status-evaluation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>workflowroutine-status-evaluation</name>
    <properties>
        <fully.qualified.main.class>${project.groupId}.tessera.industrial_pipeline.workflowroutine.status_evaluation.StatusEvaluationWorkflowRoutine</fully.qualified.main.class>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.byzatic</groupId>
            <artifactId>lib-tessera-dfe-project-io</artifactId>
            <version>${version.tessera_project_io}</version>
        </dependency>
        <dependency>
            <groupId>io.github.byzatic</groupId>
            <artifactId>sharedresources-project-common</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.byzatic</groupId>
            <artifactId>workflowroutine-data-generator</artifactId>
            <version>1.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.byzatic</groupId>
            <artifactId>workflowroutine-processing-status</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <generator.artifact>${project.basedir}/../workflowroutine-data-generator/target/workflowroutine-data-generator-1.1.0-shaded.jar</generator.artifact>
                        <processing.artifact>${project.basedir}/../workflowroutine-processing-status/target/workflowroutine-processing-status-1.0.0-shaded.jar</processing.artifact>
                        <shared.artifact>${project.basedir}/../sharedresources-project-common/target/sharedresources-project-common-1.0.0-shaded.jar</shared.artifact>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
